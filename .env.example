# Copy this file to .env and fill every required blank before deployment.
COMPOSE_PROJECT_NAME=dashboard-project
APP_VERSION=1.0.0
ASPNETCORE_ENVIRONMENT=Production
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
DATA_VOLUME_NAME=dashboard-project-data
SEED_SHA256=A8165F4C37F80430408F9290189E158CBD17E6B817884283A2EC0EEA19052EB8
APP_NETWORK_SUBNET=172.30.0.0/24
FRONTEND_INTERNAL_IP=172.30.0.3

# Direct client -> Compose frontend deployments use one forwarded hop.
# Keep the first known proxy equal to FRONTEND_INTERNAL_IP.
# For an additional trusted TLS proxy, read INSTALLATION.md before changing
# these values; never trust arbitrary proxy addresses or headers.
REVERSE_PROXY_KNOWN_PROXIES=172.30.0.3
REVERSE_PROXY_FORWARD_LIMIT=1

# Use the exact public origin, including scheme and non-default port.
# Separate multiple origins with commas only if the API configuration supports it.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# REQUIRED: generate a cryptographically random value; do not use a placeholder.
JWT_SECRET=
JWT_ISSUER=PIR-API
JWT_AUDIENCE=PIR-React
JWT_EXPIRY_MINUTES=180

# REQUIRED FOR A NEW DATABASE: remove all three after the first successful login.
# Password: 12+ chars with upper/lower case, digit and special character.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# REQUIRED: Community, Professional or Enterprise.
# Confirm eligibility or purchase status before selecting this value.
# Evaluation is rejected in Production.
QUESTPDF_LICENSE=

# Official .NET Linux container "app" user/group. Keep aligned with the API image.
SQLITE_UID=1654
SQLITE_GID=1654

TZ=Europe/Istanbul
